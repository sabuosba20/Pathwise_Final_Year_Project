FLASK_APP=run.py
APP_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-this-with-a-long-random-secret-key
JWT_SECRET_KEY=replace-this-with-a-long-random-jwt-secret
JWT_ACCESS_TOKEN_MINUTES=30
DATABASE_URL=sqlite:///pathwise.db
FRONTEND_URL=http://localhost:5173
RATELIMIT_STORAGE_URI=memory://
# Set a comma-separated host allowlist in production, for example:
# TRUSTED_HOSTS=pathwise.example.com
